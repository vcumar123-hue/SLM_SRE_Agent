# ── AI SRE Platform — vast.ai Environment Template ────────────────────────────
# Copy this to .env and fill in the values before running docker compose.
# Never commit .env to git.

# ── LLM Configuration (Groq — free tier available at console.groq.com) ────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
FALLBACK_PROVIDER=groq

# Primary model — set to groq for cloud deployment (no local GPU required)
PRIMARY_CHAT_MODEL=llama-3.3-70b-versatile
PRIMARY_PROVIDER=groq

# Optional: OpenAI fallback (leave blank if not using)
OPENAI_API_KEY=

# ── Embedding Model (CPU-based, no GPU required) ───────────────────────────────
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_PROVIDER=local

# ── Postgres ───────────────────────────────────────────────────────────────────
PGHOST=aiops-postgres
PGPORT=5432
PGDATABASE=aiops
PGUSER=aiops_user
PGPASSWORD=ChangeMe_StrongPassword123!

# ── Qdrant (vector store) ──────────────────────────────────────────────────────
QDRANT_URL=http://aiops-qdrant:6333

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=poc
PORT=8000
AIOPS_DEFAULT_TENANT_ID=poc_client
AIOPS_TENANT_CONFIG_DIR=/app/tenant_config

# ── Confidence & Retrieval Thresholds ─────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.48
MIN_RETRIEVAL_SCORE=0.25

# ── Security (set a random string to enable API key auth) ─────────────────────
# Leave blank to disable auth (suitable for closed-network POC)
AIOPS_API_KEY=

# ── Notifications (optional) ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
WEBHOOK_NOTIFY_URL=

# ── Data Package (for import_postgres.sh) ─────────────────────────────────────
# Set to a URL if you uploaded your data package to GitHub Releases / S3
# Leave blank if you will scp the data_package/ folder directly
DATA_PACKAGE_URL=

# ── vast.ai specific ──────────────────────────────────────────────────────────
# These are set automatically by vast.ai; you normally don't need to change them
# PUBLIC_IP=<auto>
# OPEN_PORTS=8001,8501
