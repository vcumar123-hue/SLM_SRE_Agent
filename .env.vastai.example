# ============================================================
# AI SRE Platform — vast.ai POC Environment Template
# Copy to .env and fill in your values before deploying.
# ============================================================

# ── LLM Configuration (Groq — no local GPU required) ────────
PRIMARY_PROVIDER=groq
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Disable LM Studio (not available in cloud deployment)
LM_STUDIO_BASE_URL=

# ── Embedding Model (CPU-based, downloaded at image build) ───
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DEVICE=cpu

# ── Database ─────────────────────────────────────────────────
PGHOST=aiops-postgres
PGPORT=5432
PGDATABASE=aiops
PGUSER=aiops_user
PGPASSWORD=AiOpsPOC2024!

# ── Vector Store ─────────────────────────────────────────────
QDRANT_URL=http://aiops-qdrant:6333

# ── Tenant Configuration ─────────────────────────────────────
AIOPS_DEFAULT_TENANT_ID=poc_client
AIOPS_TENANT_CONFIG_DIR=/app/tenant_config

# ── API Security (Release 1) ─────────────────────────────────
# Dev/POC: leave everything empty and the API is open (principal "dev-open", role l3).
# Production: set AIOPS_ENV=production; the app refuses to start without principals.
# AIOPS_PRINCIPALS maps bearer tokens to identities. Roles: l1 l2 l3 admin. kind: human | service.
# Live execution needs a human l3 (or a service identity with a server-created autonomous intent).
# Example (one line):
# AIOPS_PRINCIPALS={"<token-1>":{"id":"alice","role":"l3","kind":"human"},"<token-2>":{"id":"telemetry-svc","role":"l2","kind":"service"}}
# The Streamlit UI authenticates with the token of one of the principals above:
# AIOPS_UI_API_KEY=<token-1>
AIOPS_ENV=
AIOPS_PRINCIPALS=
AIOPS_UI_API_KEY=
# Legacy single shared key (maps to principal "shared-key", role l2; cannot approve or execute live):
AIOPS_API_KEY=

# ── Release 1 Wave 1b ────────────────────────────────────────
# Seconds a request waits for the automation queue lock before the API answers HTTP 503 (Retry-After).
AIOPS_QUEUE_LOCK_TIMEOUT=10
# External LLM calls are audited first; if the audit cannot be persisted the call is DENIED (fail closed).
# Isolated development only: set to true to allow unaudited external calls. Ignored when AIOPS_ENV=production.
AIOPS_ALLOW_UNAUDITED_EXTERNAL_LLM=false

# ── Backend URL (used by Streamlit UI) ────────────────────────
# In docker-compose this is the service name; for standalone set to localhost
AIOPS_BACKEND_URL=http://aiops-app:8000

# ── Model Parameters ─────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.48
MIN_RETRIEVAL_SCORE=0.25
FALLBACK_PROVIDER=groq

# ── Streamlit ─────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ── Safety Gate — Snapshot Mode ──────────────────────────────
# Controls which infrastructure source the Safety Gate reads during pre-execution check.
# Only one should be true; if both are false, dry (synthetic) mode is used — POC/dev only.
#
# Production with ServiceNow CMDB:
#   CMDB_ENABLED=true   (reads CI state from CMDB via adapters/servicenow_cmdb.py)
#   LAB_SNAPSHOT_ENABLED=false
#
# Lab with Docker containers reachable:
#   CMDB_ENABLED=false
#   LAB_SNAPSHOT_ENABLED=true   (runs docker exec to read real container state)
#
# POC / dev (no live infra access — synthetic state, gate is advisory only):
#   CMDB_ENABLED=false
#   LAB_SNAPSHOT_ENABLED=false
CMDB_ENABLED=false
LAB_SNAPSHOT_ENABLED=false

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
APP_ENV=poc
