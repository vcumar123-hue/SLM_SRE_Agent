{
  "tenant_id": "{{tenant_id}}",
  "display_name": "{{display_name}}",
  "knowledge_scope_default": "client_private",
  "collections": {
    "client_private": "{{tenant_id}}_index",
    "global_learned": "global_learned_patterns_index",
    "global_base": "global_base_index"
  },
  "branding": {
    "client_label": "{{display_name}}",
    "product_label": "AI SRE Platform"
  },
  "fallback_policy": {
    "enabled": true,
    "allow_force_fallback_for_engineers": true,
    "user_visible_force_fallback": false
  },
  "retrieval_policy": {
    "default_search_order": [
      "{{tenant_id}}_index",
      "global_learned_patterns_index",
      "global_base_index"
    ],
    "tenant_match_priority": "high",
    "global_learned_priority": "medium_high",
    "global_base_priority": "medium"
  },
  "qdrant": {
    "active_collections": [
      "{{tenant_id}}_index",
      "global_learned_patterns_index",
      "global_base_index"
    ],
    "vector_payload_required_fields": [
      "collection_name",
      "tenant_id",
      "knowledge_scope",
      "classification",
      "domain",
      "source_type",
      "source_layer"
    ]
  },
  "knowledge_governance": {
    "external_knowledge_contribution": "disabled",
    "allow_base_release_import": true,
    "allow_global_pattern_usage": true,
    "allow_client_data_export": false,
    "allow_sanitized_pattern_export": false,
    "allow_cross_client_learning_contribution": false,
    "export_approval_required": true,
    "local_learning_enabled": true,
    "client_local_backtesting_enabled": true,
    "global_backtesting_enabled": false
  },
  "created_at": "{{created_at}}",
  "updated_at": "{{updated_at}}",
  "external_llm_policy": {
    "allow_external_llm": false,
    "allowed_llm_providers": [],
    "external_llm_redaction": "basic"
  }
}
